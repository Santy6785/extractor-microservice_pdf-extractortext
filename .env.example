# ==============================================================================
# Variables de Entorno - Microservicio Extractor
# Copiar este archivo a .env y completar los valores. No commitear .env.
# ==============================================================================

# --- Servidor
PORT=80
LOG_LEVEL=INFO

# --- Concurrencia y cola de extracción
EXTRACT_CONCURRENCY=3
EXTRACT_QUEUE_TIMEOUT=10
EXTRACT_MAX_QUEUE=8
EXTRACT_CACHE_SIZE=32

# --- Límites de PDF
PDF_MAX_FILE_SIZE_MB=50
